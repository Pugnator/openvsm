#include "resources.h"

// Executable version information.
1 VERSIONINFO
 FILEVERSION FILEVER
 PRODUCTVERSION PRODUCTVER
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "Lua bindings for Proteus VSM\0"
            VALUE "CompanyName", "432 Works"
            VALUE "FileDescription", "OpenVSM Proteus model runtime"
            VALUE "FileVersion", STRFILEVER
            VALUE "InternalName", "openvsm"
            VALUE "LegalCopyright", "Lavrentii Ivanov"
            VALUE "OriginalFilename", "openvsm.dll"
            VALUE "ProductName", "OpenVSM"
            VALUE "ProductVersion", STRPRODUCTVER
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

